# RecruitShield AI - environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

# Gemini API Key - for AI-powered recruiter summaries
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Token - for sentence embedding model inference
HF_TOKEN=your_huggingface_token_here

# SerpApi Key - enables LIVE employer verification in the Anomaly Firewall
# (https://serpapi.com/manage-api-key). Optional: without it the firewall uses the
# built-in reference table only and the app works fully offline.
SERPAPI_API_KEY=your_serpapi_key_here

# Max live SerpApi requests per server process (protects your monthly quota). Default: 50
SERPAPI_MAX_LIVE_CALLS=50

# Allowed CORS Origins (defaults to * for open access)
ALLOWED_ORIGINS=*
